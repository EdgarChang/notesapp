# Copy to .env.local and fill in real values. .env.local is gitignored.
# Supabase dashboard: Project Settings -> API

# Safe to expose. NEXT_PUBLIC_ variables are compiled into the browser bundle.
# The publishable key is public by design; Row Level Security is what protects
# the data behind it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses Row Level Security entirely, so it must never be
# prefixed NEXT_PUBLIC_ and must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Used by the check-in and weekly note routes from step 7.
ANTHROPIC_API_KEY=
